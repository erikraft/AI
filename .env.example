# Server-side variables for Vercel Functions. Use Vercel Settings for the real values.
# Replace this placeholder with the full valid/minified service-account JSON in Vercel's secret field.
FIREBASE_SERVICE_ACCOUNT_JSON=REPLACE_WITH_VALID_MINIFIED_FIREBASE_SERVICE_ACCOUNT_JSON
# MongoDB Atlas connection string. Keep this server-side and never use a NEXT_PUBLIC_ prefix.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/ErikrafTAI?retryWrites=true&w=majority
# Optional database name; defaults to ErikrafTAI.
MONGODB_DATABASE=ErikrafTAI
HF_SPACE_ID=ErikrafT/erikraft-ai
# Optional, only if Hugging Face requires authenticated Space access.
HF_TOKEN=
# Must match the secret set in Hugging Face Space Settings; minimum 32 characters.
HF_SPACE_API_SECRET=REPLACE_WITH_THE_SAME_RANDOM_SECRET_CONFIGURED_IN_HUGGING_FACE
# Experimental model attempts are enabled by default; set explicitly to false only to disable one.
ENABLE_COSMOS_VIDEO=true
ENABLE_QWEN_TEXT=true
ENABLE_QWEN_IMAGE=true

# Required only when saving MCP OAuth access tokens. Generate with: openssl rand -hex 32
# Keep this secret stable; rotating it makes previously stored MCP tokens unreadable.
MCP_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET
